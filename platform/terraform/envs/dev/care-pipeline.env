# Care pipeline (Dataflow streaming job) settings for dev.
# Read by cicd/deploy_care_job.sh and cicd/stop_care_job.sh.

# Worker VM type and autoscaling ceiling. The job starts with 1 worker; Dataflow adds workers (up to
# the ceiling) when the Pub/Sub backlog grows and removes them when it clears. One n1-standard-2 runs
# at ~95% CPU and falls behind at ~100 records/s, so the ceiling is 3; idle, it still runs 1 worker.
# Change it on a running job without a redeploy:
#   gcloud dataflow jobs update-options <JOB_ID> --region=us-central1 --max-num-workers=3
CARE_MACHINE_TYPE=n1-standard-2
CARE_MAX_WORKERS=3

# How teardown stops the job: cancel (dev: stop now) or drain (prod: finish in-flight data first).
CARE_ON_STOP=cancel
