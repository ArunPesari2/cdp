# Care pipeline (Dataflow streaming job) settings for dev.
# Read by cicd/deploy_care_job.sh and cicd/stop_care_job.sh.

# Worker VM type and autoscaling ceiling.
CARE_MACHINE_TYPE=n1-standard-2
CARE_MAX_WORKERS=1

# How teardown stops the job: cancel (dev: stop now) or drain (prod: finish in-flight data first).
CARE_ON_STOP=cancel
